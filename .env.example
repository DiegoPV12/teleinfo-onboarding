# local -> borrador en memoria, sin simulación: el flujo se recorre a mano
# http  -> tótem real
VITE_TRANSPORT=local

VITE_API_BASE=http://localhost:8000
VITE_TOTEM_ID=totem-1
VITE_POLL_MS=1000
VITE_EDIT_DEBOUNCE_MS=400

# Slider de respaldo en la bienvenida: apáguelo cuando la detección sea fiable
VITE_SHOW_SLIDER=true

# command -> POST /command { type: registration_data_confirmed, target: <paso> }
# fields  -> POST /fields  con un pseudo-campo <paso>_verified
VITE_VERIFY_MODE=command
