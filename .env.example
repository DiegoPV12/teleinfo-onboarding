# local -> central en memoria, sin red: el flujo se recorre a mano
# http  -> central real (rt-face-recognition)
VITE_TRANSPORT=http

VITE_API_BASE=https://facerec.nexarobotics.org

# Token de la central. OPCIONAL: la escritura (POST/PATCH /api/persons) y
# GET /api/totems/by-code/{code}/current-person son publicas. Solo hace
# falta para leer las fotos del paso 4 y para releer la persona propia.
VITE_API_TOKEN=

# Identifica al totem-avatar. Normalmente llega en la URL (?totem=<code>);
# esto es solo el respaldo para desarrollo. Es el CODE legible del totem
# (ej. totem-01), no el UUID interno de totems.id.
VITE_TOTEM_ID=

VITE_POLL_MS=1500
VITE_EDIT_DEBOUNCE_MS=400

# Sin actividad en el formulario durante este tiempo, se abandona el
# registro y se vuelve a la bienvenida.
VITE_ABANDON_MS=30000

VITE_PHONE_PREFIX=+591

# polling -> se sondea current-person; sin slider
# slider  -> se entra a mano y la persona se crea al cerrar el paso 1
# hybrid  -> se sondea y ademas se ofrece el slider (gana lo primero)
VITE_START_MODE=hybrid

# Salta el paso de fotos en el registro a mano (slider)
VITE_SKIP_PHOTOS=true

# Trazas en la consola del navegador. false las apaga por completo.
VITE_DEBUG=true
